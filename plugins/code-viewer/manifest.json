    "cpp",
    "h",
    "hpp",
    "cs",
    "rb",
    "php",
    "sh",
    "bash",
    "zsh",
    "ps1",
    "bat",
    "sql",
    "json",
    "yaml",
    "yml",
    "toml",
    "ini",
    "conf",
    "xml",
    "html",
    "css",
    "scss",
    "vue",
    "kt",
    "swift",
    "md",
    "txt",
    "log",
    "csv"
